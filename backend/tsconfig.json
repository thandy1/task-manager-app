{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@src/*": ["./src/*"]
        },
    },
    "include": ["src", "tests"]
}